# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real token here.
#
#   printf 'BUILDLENS_TOKEN=%s\n' "$(openssl rand -hex 32)" > .env

# Shared secret CI presents as `Authorization: Bearer <token>`. The server
# refuses to start without it, unless BUILDLENS_ALLOW_ANONYMOUS=1 is set.
BUILDLENS_TOKEN=

# Run without authentication. Only for a trusted network — anyone who can reach
# the port can write builds.
# BUILDLENS_ALLOW_ANONYMOUS=1

# Worker threads and Postgres connections. Threads above pool size only block.
# BUILDLENS_POOL_SIZE=8
# BUILDLENS_THREADS=8
